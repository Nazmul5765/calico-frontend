@using System.Text.Json
@using System.Timers
@using lofi_frontend.Models

@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

<div class="display-6 fw-bold text-white font-monospace shadow-sm bg-dark bg-opacity-20 py-3 px-4 rounded-3">
	<div class="d-flex flex-row align-content-center justify-content-center gap-4">
		<div role="timer" aria-live="polite" aria-label="Task timer">
		@TimerDisplay
		</div>
		<button class="btn p-0" style="filter: invert(1) brightness(2);" aria-label="Reset timer" @onclick="Dispose">
			<img src="images/reset.png" height="30" />
		</button>
	</div>
</div>

@code {
	private System.Timers.Timer? _timer { get; set; } = null;
	private TaskTimer _taskTimer { get; set; } = new TaskTimer();
	public bool IsCounting { get; set; } = false;

	private bool isPomodoro = false;

	private string TimerDisplay => new TimeSpan(0, 0, _taskTimer.Duration).ToString("c");

	[Parameter]
	public EventCallback OnPomodoroFinished { get; set; }

	public async Task StartPomodoro()
	{
		isPomodoro = true;

		_taskTimer.Duration = 25 * 60;

		if (_timer == null)
		{
			SetTimer();
		}

		_timer?.Start();

		await InvokeAsync(StateHasChanged);
	}

	private void SetTimer()
	{
		_timer = new(1000);
		_timer.Elapsed += OnTimedEvent;
	}

	public async Task StartTimer()
	{
		//isPomodoro = false;
		if (_timer == null) {
			Console.WriteLine("Creating new timer");
			SetTimer();
		}

		if (!_timer?.Enabled ?? false)
		{
			Console.WriteLine("Starting Timer");
			_timer?.Start();
			IsCounting = true;

		} else {
			Console.WriteLine("Timer already running");
			return;
		}
	}

	private void OnTimedEvent(Object source, ElapsedEventArgs e)
	{
		if (isPomodoro)
		{
			if (_taskTimer.Duration > 0)
			{
				_taskTimer.Duration -= 1;
			} else
			{
				_timer?.Stop();
				InvokeAsync(OnPomodoroFinished.InvokeAsync);
			}

		}
		else
		{
			_taskTimer.Duration += 1;
		}

		InvokeAsync(StateHasChanged);
	}

	public async Task StopTimer()
	{
		if (_timer?.Enabled ?? false) {
			Console.WriteLine("Stopping Timer");
			_timer.Stop();
			IsCounting = false;
		}
		else
		{
			Console.WriteLine("Timer already stopped");
			return;
		}
	}

	public async Task Dispose()
	{
		if (_timer is not null && !_timer.Enabled)
		{
			Console.WriteLine("Disposing Timer");
			_timer.Stop();
			_timer.Dispose();
			_timer = null;
			_taskTimer.Duration = 0;
		}
			isPomodoro = false;
			
			await InvokeAsync(StateHasChanged);
		
	}

	public async Task SaveTaskTime()
	{
		if (_taskTimer.Duration == 0)
		{
			Console.WriteLine("No time to save");
			return;
		}

		if (_timer?.Enabled ?? false)
		{
			Console.WriteLine("Stopping timer before saving");
			_timer.Stop();
		}

		var url = "TaskTimers";

		_taskTimer.DateCreated = DateTime.UtcNow;
		_taskTimer.DateUpdated = DateTime.UtcNow;
		_taskTimer.ProjectId = 1; // Placeholder, replace with actual project ID as needed
		_taskTimer.Id = null; // Ensure ID is null for new entries
		Console.WriteLine(JsonSerializer.Serialize(_taskTimer));

		try
		{
			var httpClient = HttpClientFactory.CreateClient("BackendApi");
			var response = await httpClient.PostAsJsonAsync<TaskTimer>(url, _taskTimer);
			Console.WriteLine(await response.Content.ReadAsStringAsync());

			if (response.IsSuccessStatusCode)
			{
				await JS.InvokeVoidAsync("alert", "Task time saved successfully!");
			}
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error saving task: {ex.Message}");
			await JS.InvokeVoidAsync("alert", "Failed to save task time.");
		}
	}
}
