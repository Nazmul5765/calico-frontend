@using lofi_frontend.Security
@using lofi_frontend.Services
@attribute [Authorize]
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject AuthService AuthService
@inject JWTAuthenticationStateProvider AuthStateProvider

<nav class="navbar navbar-light p-0" aria-label="Main Navigation">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">
            <img src="./images/CalicoLogo.png" alt="Logo image of calico cat" height="60"/>
        </a>
            @* <h1 class="text-white ps-5 ms-5" aria-hidden="true;">Calico</h1> *@

        <ul class="navbar-nav nav-links">
            <li><NavLink class="button-nav" href="/">Home</NavLink></li>
                <AuthorizeView>
                    <Authorized>
                        <li>
                            <NavLink
                                class="button-nav"
                                href="/Dashboard">
                                Profile
                            </NavLink>
                        </li>
                        <li>
                            <NavLink
                                class="button-nav"
                                href="/">
                                Logout
                            </NavLink>
                            </li>
                    </Authorized>
                    <NotAuthorized>
                        <li><NavLink class="button-nav" href="/Login">Login</NavLink></li>
                    </NotAuthorized>
                </AuthorizeView>
            @* <li><NavLink class="button-nav" href="/Search">Search</NavLink></li> *@
        </ul>
    </div>
</nav>

@code {
    public HttpClient client = new();

    protected override void OnInitialized()
    {
        client = HttpClientFactory.CreateClient("BackendApi");
    }
}
