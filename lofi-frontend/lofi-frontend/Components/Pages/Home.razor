@using Google.Apis.Http
@using lofi_frontend.Components.MusicPlayer
@using lofi_frontend.Components.Pages.Search
@using lofi_frontend.Models
@using IHttpClientFactory = System.Net.Http.IHttpClientFactory
@page "/"

@inject IHttpClientFactory HttpClientFactory;

<PageTitle>Calico LoFi</PageTitle>

<div class="home-page page-container">
	<div class="home-layout col-12 col-lg-10 col-xl-8 col-xxl-7">
		<div class="welcome-message">
			<h1 class="text-white text-shadow-lg">Welcome to Calico</h1>
			<p>
				Calico blends lo‑fi beats, timers, and project tracking into a single distraction‑free 
				space that helps you work with clarity and rhythm.
			</p>
		</div>

		<div class="home-card">
			<MusicPlayerComponent @ref="MusicPlayerRef"
								  VideoCode="@_videoCode"
								  GetSearchTerm="GetSearchTerm" />
		</div>

		<div class=" featured-moods-section home-card">
			@* <h3>Results</h3> *@

			<SearchField GetSearchTerm="GetSearchTerm" />
			<SearchList @ref="SearchResultRef"
						YoutubeVideos="YoutubeVideos"
						GetVideoCode="GetVideoCode" />

		</div>
	</div>
</div>

@code {
	private string _videoCode = "n61ULEU7CO0";
	private string SearchTerm { get; set; } = "";
	private string? ErrorMessage { get; set; }
	private List<Music>? YoutubeVideos { get; set; }

	// private HttpClient HttpClient { get; set; } = new();

	private MusicPlayerComponent? MusicPlayerRef { get; set; }
	private SearchList? SearchResultRef { get; set; }

	protected override async Task OnInitializedAsync()
	{
		await GetVideo();
	}

	private async Task GetVideoCode(string videoCode)
	{
		if (MusicPlayerRef != null)
		{
			Console.WriteLine("Getting video code to change video");
			_videoCode = videoCode[^11..];
			// VideoCode = "n61ULEU7CO0";
			Console.WriteLine($"Code: {_videoCode}");
			await MusicPlayerRef.LoadNewVideo(_videoCode);
			await InvokeAsync(StateHasChanged);
		}
	}

	private async Task GetSearchTerm(string searchTerm)
	{
		Console.WriteLine("Getting Search");
		SearchTerm = searchTerm;
		Console.WriteLine($"Search: {searchTerm}");
		Console.WriteLine("Searching for videos");
		await GetVideo();
	}

	private async Task GetVideo()
	{
		Console.WriteLine("attempting to search for videos");
		try
		{
			ErrorMessage = null;
			Console.WriteLine("Creating request");

			var httpClient = HttpClientFactory.CreateClient("BackendApi");
			YoutubeVideos = await httpClient.GetFromJsonAsync<List<Music>>(
				"Youtube" + $"?search={SearchTerm}"
			);
		}
        catch (Exception ex)
        {
            ErrorMessage = $"Could not load videos: {ex.Message}";
            YoutubeVideos = new List<Music>();
        }
    }
}
