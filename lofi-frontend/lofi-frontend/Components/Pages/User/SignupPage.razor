@using System.Reflection.Metadata
@using lofi_frontend.Models
@using lofi_frontend.Models.Enum
@using lofi_frontend.Security
@using lofi_frontend.Services
@page "/Signup"

@rendermode InteractiveServer

@inject NavigationManager NavigationManager;
@inject AuthService AuthService
@inject JWTAuthenticationStateProvider AuthStateProvider

<PageTitle>Signup</PageTitle>
<div class="signup-page">
	<div class="signup-layout">
		<div class="container-fluid d-flex justify-content-center align-items-start">
			<div class="card p-4 shadow my-5" style="width: 100%; max-width: 500px;">

				<h1 class="text-center h3 mb-4">Create your account</h1>
				<div aria-live="polite">
					<EditForm EditContext="editContext"
							  OnValidSubmit="HandleSignup">

						<DataAnnotationsValidator />

						<div class="mb-3">
							<label for="firstname-input" class="form-label" aria-required="true">First Name</label>
							<InputText id="firstname-input" class="form-control" @bind-Value="user.UserData.FirstName" />
							<div class="text-danger small"><ValidationMessage For="@(() => user.UserData.FirstName)" /></div>
						</div>

						<div class="mb-3">
							<label for="lastname-input" class="form-label" aria-required="true">Last Name</label>
							<InputText id="lastname-input" class="form-control" @bind-Value="user.UserData.LastName" />
							<div class="text-danger small"><ValidationMessage For="@(() => user.UserData.LastName)" /></div>
						</div>

						<div class="mb-3">
							<label for="email-input" class="form-label" aria-required="true">Email address</label>
							<InputText id="email-input" type="email" class="form-control" @bind-Value="user.UserData.Email" />
							<div class="text-danger small"><ValidationMessage For="@(() => user.UserData.Email)" /></div>
						</div>

						<div class="mb-3">
							<label for="username-input" class="form-label" aria-required="true">Username</label>
							<InputText id="username-input" class="form-control" @bind-Value="user.UserData.Username" />
							<div class="text-danger small"><ValidationMessage For="@(() => user.UserData.Username)" /></div>
						</div>

						<div class="mb-2">
							<label for="password-input" class="form-label" aria-required="true">Password</label>
							<InputText id="password-input"
									   type="@(ShowPassword ? "text" : "password")"
									   class="form-control"
									   @bind-Value="user.Password" />
							<div class="text-danger small"><ValidationMessage For="@(() => user.Password)" /></div>
						</div>

            
						<div class="mb-2">
							<label for="confirm-password-input" class="form-label" aria-required="true">Confirm Password</label>
							<InputText id="confirm-password-input"
									   type="@(ShowPassword ? "text" : "password")"
									   class="form-control"
									   @bind-Value="ConfirmPassword" />
							<div class="text-danger small"><ValidationMessage For="@(() => ConfirmPassword)" /></div>
						</div>

						<div class="mb-3 form-check">
							<input type="checkbox" class="form-check-input" id="showPassword" @bind="ShowPassword" />
							<label class="form-check-label" for="showPassword">Show Password</label>
						</div>


						<div class="mb-3">
							<label for="Date-of-birth" class="form-label" aria-required="true">Date of Birth</label>
							<InputDate id="Date-of-birth" class="form-control" @bind-Value="user.UserData.Dob" />
							<div class="text-danger small"><ValidationMessage For="@(() => user.UserData.Dob)" /></div>
						</div>

						<div class="mb-4">
							<label for="gender" class="form-label" aria-required="true">Gender</label>
							<InputSelect id="gender" class="form-select" @bind-Value="user.UserData.Gender">
								@foreach (var gender in Enum.GetValues(typeof(Gender)))
								{
									<option value="@gender">
										@switch (gender)
										{
											case Gender.NonBinary:
												@("Non-Binary")
												break;
											case Gender.PreferNotToSay:
												@("Prefer Not To Say")
												break;
											default:
												@gender.ToString()
												break;
										}
									</option>
								}
							</InputSelect>
						</div>
						@if (!string.IsNullOrEmpty(_errorMessage))
						{
							<div class="alert alert-danger p-2 small text-center mb-3" role="alert" aria-live="assertive">
								@_errorMessage
							</div>
						}
						<button class="btn btn-primary w-100 mb-3" type="submit">Sign Up</button>

						<hr />

						<div class="text-center">
							<p class="mb-2 text-muted">Already have an account?</p>
							<NavLink href="Login" class="btn btn-outline-secondary w-100">
								Log in
							</NavLink>
						</div>

					</EditForm>
				</div>
			</div>
		</div>
	</div>
</div>
@code {
	public UserWithPassword? user { get; set; }
	public string ConfirmPassword { get; set; } = string.Empty;
	private string? _errorMessage;


	private EditContext? editContext;
	private ValidationMessageStore? validationMessageStore;

	private bool ShowPassword { get; set; } = false;

	private void TogglePasswordVisibility()
	{
		ShowPassword = !ShowPassword;
		StateHasChanged();
	}
	protected override void OnInitialized()
	{
		user = new UserWithPassword
		{
			UserData = new UserData(),
			Password = string.Empty
		};
		editContext = new EditContext(user);
		editContext.OnValidationRequested += HandleValidationRequested;
		validationMessageStore = new ValidationMessageStore(editContext);
	}

	private void HandleValidationRequested(object? sender, ValidationRequestedEventArgs e)
	{
		validationMessageStore?.Clear();

		if (user.UserData.Dob != default)
		{
			var age = DateTime.Today.Year - user.UserData.Dob.Year;
			if (user.UserData.Dob > DateTime.Today.AddYears(-age))
				age--;

			if (age < 13)
			{
				validationMessageStore?.Add(() => user.UserData.Dob, "You must be at least 13 years old.");
			}
		}

		if (user.Password != ConfirmPassword)
		{
			validationMessageStore?.Add(() => ConfirmPassword, "Passwords do not match.");
		}

		editContext?.NotifyValidationStateChanged();
	}

	private async Task HandleSignup()
	{

		_errorMessage = null;
		try
		{
			var success = await AuthService.SignUp(user);

			if (success)
			{
				AuthStateProvider.NotifyUserLogin();
				NavigationManager.NavigateTo("/");
			}
			else
			{
				_errorMessage = "Could not create your account. Please try again.";
			}

		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error creating user: {ex.Message}");
			_errorMessage = "An error occurred while creating your account. Please try again later.";
		}
	}

	public void Dispose()
	{
		if (editContext != null)
		{
			editContext.OnValidationRequested -= HandleValidationRequested;
		}
	}
}
