@page "/reset-password"
@using lofi_frontend.Models
@using System.ComponentModel.DataAnnotations
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager

<PageTitle>Reset Password</PageTitle>
<div class="reset-page">
    <div class="reset-layout">
    <div class="card reset-password-card shadow">

        <h1 class="text-center reset-heading">Choose a New Password</h1>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger custom-alert" role="alert" aria-live="assertive">
                @errorMessage
            </div>
        }
        <div aria-live="polite">
        <EditForm EditContext="editContext" OnValidSubmit="HandlePasswordUpdate">
            <DataAnnotationsValidator />

            <div class="mb-4">
                <label for="new-password" class="form-label custom-label" aria-required="true">New Password</label>
                <InputText id="new-password" type="password" @bind-Value="userSettings.NewPassword" class="form-control custom-input" placeholder="••••••••" />
                <div class="text-danger small mt-1"><ValidationMessage For="@(() => userSettings.NewPassword)" /></div>
            </div>

            <div class="mb-3">
                <label for="repeat-password" class="form-label custom-label" aria-required="true">Repeat Password</label>
                <InputText id="repeat-password" type="password" @bind-Value="userSettings.ConfirmNewPassword" class="form-control custom-input" placeholder="••••••••" />
                <div class="text-danger small mt-1"><ValidationMessage For="@(() => userSettings.ConfirmNewPassword)" /></div>
            </div>

            <p class="password-hint"><span aria-hidden="true">💡 </span>Please ensure your password is at least 8 characters long and includes a special character.</p>

            <button class="btn btn-primary w-100 reset-submit-btn" type="submit" disabled="@isSubmitting" aria-busy="@isSubmitting">
                @(isSubmitting ? "Updating..." : "Submit Changes")
            </button>
        </EditForm>
        </div>
    </div>
    </div>
</div>


@code {
    private UserSettingsForm userSettings = new UserSettingsForm();
    private string errorMessage = string.Empty;
    private bool isSubmitting = false;
    private EditContext? editContext;
    private ValidationMessageStore? validationMessageStore;

    protected override void OnInitialized()
    {
        editContext = new EditContext(userSettings);
        editContext.OnValidationRequested += VerifyPasswordsMatch;
        validationMessageStore = new ValidationMessageStore(editContext);
    }

    private void VerifyPasswordsMatch(object? sender, ValidationRequestedEventArgs e)
    {
        validationMessageStore?.Clear();
        if (userSettings.NewPassword != userSettings.ConfirmNewPassword)
        {
            validationMessageStore?.Add(() => userSettings.ConfirmNewPassword, "Passwords do not match.");
        }
        editContext?.NotifyValidationStateChanged();
    }

    private async Task HandlePasswordUpdate()
    {
        isSubmitting = true;
        errorMessage = string.Empty;
        try
        {
            var httpClient = HttpClientFactory.CreateClient("BackendApi");
            var response = await httpClient.PostAsJsonAsync("/Auth/update-password", userSettings);
            if (response.IsSuccessStatusCode)
            {
                NavigationManager.NavigateTo("/Login");
            }
            else
            {
                errorMessage = "Failed to reset password. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }


    public void Dispose()
    {
        if (editContext != null)
        {
            editContext.OnValidationRequested -= VerifyPasswordsMatch;
        }
    }
}
