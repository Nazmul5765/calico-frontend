@using lofi_frontend.Models
@using lofi_frontend.Models.Enum
@using lofi_frontend.Services
@inject AuthService AuthService

<div class="container-fluid d-flex justify-content-center align-items-start min-vh-100">
    <div class="card p-4 shadow" style="width: 100%; max-width: 500px;">

        <h2 class="mb-3">Update Your Details</h2>

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success" aria-live="polite">
                @successMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger" aria-live="assertive" role="alert">@errorMessage</div>
        }

        @if (isLoading)
        {
            <div class="text-center p-3">
                <div class="spinner-border text-primary" role="status" aria-label="Loading"></div>
                <p class="mt-2">Loading user data...</p>
            </div>
        }
        else
        {
            <EditForm Model="user"
                      OnValidSubmit="HandleUpdateDetails"
                      FormName="UpdateDetailsForm">

                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label for="firstname-input" class="form-label">First Name</label>
                    <InputText id="firstname-input" class="form-control" @bind-Value="user.FirstName" />
                    <div class="text-danger small" aria-live="polite">
                        <ValidationMessage For="@(() => user.FirstName)" />
                    </div>
                </div>

                <div class="mb-3">
                    <label for="lastname-input" class="form-label">Last Name</label>
                    <InputText id="lastname-input" class="form-control" @bind-Value="user.LastName" />
                    <div class="text-danger small" aria-live="polite">
                        <ValidationMessage For="@(() => user.LastName)" />
                    </div>
                </div>

                <div class="mb-3">
                    <label for="email-input" class="form-label">Email address</label>
                    <InputText id="email-input" type="email" class="form-control" @bind-Value="user.Email" />
                    <div class="text-danger small" aria-live="polite">
                        <ValidationMessage For="@(() => user.Email)" />
                    </div>
                </div>

                <div class="mb-3">
                    <label for="username-input" class="form-label">Username</label>
                    <InputText id="username-input" class="form-control" @bind-Value="user.Username" />
                    <div class="text-danger small" aria-live="polite">
                        <ValidationMessage For="@(() => user.Username)" />
                    </div>
                </div>

                <div class="mb-3">
                    <label for="dob-input" class="form-label">Date of Birth</label>
                    <InputDate id="dob-input" class="form-control" @bind-Value="user.Dob" />
                    <div class="text-danger small" aria-live="polite">
                        <ValidationMessage For="@(() => user.Dob)" />
                    </div>
                </div>

                <div class="mb-4">
                    <label for="gender" class="form-label">Gender</label>
                    <InputSelect id="gender" class="form-select" @bind-Value="user.Gender">
                        @foreach (var gender in Enum.GetValues(typeof(Gender)))
                        {
                            <option value="@gender">
                                @switch (gender)
                                {
                                    case Gender.NonBinary:
                                        @("Non-Binary")
                                        break;
                                    case Gender.PreferNotToSay:
                                        @("Prefer Not To Say")
                                        break;
                                    default:
                                        @gender.ToString()
                                        break;
                                }
                            </option>
                        }
                    </InputSelect>
                </div>

                <button class="btn btn-success" type="submit" disabled="@isSaving">
                    @(isSaving ? "Saving..." : "Save Changes")
                </button>
                <hr />

            </EditForm>
        }

    </div>
</div>

@code {
    public UserData user { get; set; } = new UserData();
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool isSaving = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var currentUser = await AuthService.GetCurrentUser();
        if (currentUser != null)
        {
            user = currentUser;
        }
        else
        {
            errorMessage = "Could not load your details.";
        }

        isLoading = false;
        StateHasChanged();
    }

    private async Task HandleUpdateDetails()
    {
        isSaving = true;
        successMessage = string.Empty;
        errorMessage = string.Empty;

        var success = await AuthService.UpdateUser(user);

        if (success)
        {
            successMessage = "Profile updated successfully!";
        }
        else
        {
            errorMessage = "Failed to save changes. Please try again.";
        }

        isSaving = false;
    }
}
