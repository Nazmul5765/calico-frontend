    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }
    public UserData user { get; set; } = new UserData();
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool isSaving = false;
    private readonly CancellationTokenSource cts = new CancellationTokenSource();

    protected override async Task OnInitializedAsync()
    {
        user = new UserData();
        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            successMessage = string.Empty;
            var httpClient = HttpClientFactory.CreateClient("BackendApi");
            var currentUser = await httpClient.GetFromJsonAsync<UserData>($"/Users/{Id}", cts.Token);
            if (currentUser != null)
            {
                user = currentUser;
            }
            else
            {
                errorMessage = "User not found.";
            }

        }
        catch (OperationCanceledException)
        {
            Console.WriteLine("Operation was cancelled.");
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load user details.";
            Console.WriteLine($"Error fetching user details: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }

    }


    private async Task HandleUpdateDetails()
    {
        isSaving = true;
        successMessage = string.Empty;
        errorMessage = string.Empty;


        try
        {
            var httpClient = HttpClientFactory.CreateClient("BackendApi");
            var response = await httpClient.PutAsJsonAsync($"/Users/{Id}", user, cts.Token);

            if (response.IsSuccessStatusCode)
            {
                successMessage = "Profile updated successfully!";
            }
            else
            {
                errorMessage = "Failed to save changes. Please try again.";
            }
        }
        catch (OperationCanceledException)
        {
            Console.WriteLine("Save operation was cancelled.");
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred while saving.";
            Console.WriteLine($"Error updating details: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

        public void Dispose()
    {
        cts.Cancel();
        cts.Dispose();
    }

    }
