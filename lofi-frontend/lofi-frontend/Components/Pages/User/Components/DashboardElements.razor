@using lofi_frontend.Models
@using lofi_frontend.Models.Enum
@using lofi_frontend.Services

@inject IHttpClientFactory HttpClientFactory
@inject AccessTokenService AccessTokenService

<div class="dashboard-layout">
    
    <aside class="sidebar" aria-label="Dashboard navigation">
        <div class="user-card">
            <h2>@User.Username</h2>            
            <dl class="user-details">
                <dd>@User.FirstName @User.LastName</dd>
                <dd>@User.Dob.ToString("dd/MM/yyyy")</dd>
                <dd>@User.Gender</dd>
                <p>@User.Email</p>
            </dl>
            <NavLink href="/Settings">
                <button class="user-setting-button" type="button">Account Settings</button>
            </NavLink>
        </div>

        <nav class="sidebar-buttons pt-2">
            <button class="project-button"
                    aria-current="@(selectedSection == "projects" ? "page" : null)"
                    @onclick="ShowProjects">Projects
            </button>

            <button class="playlist-button"
                    aria-current="@(selectedSection == "playlists" ? "page" : null)"
                    @onclick="ShowPlaylists">Playlists
            </button>

            <button class="fave-tracks-button"
                    aria-current="@(selectedSection == "faveTracks" ? "page" : null)"
                    @onclick="ShowFaveTracks">Favourite Tracks
            </button>
        </nav>

        <section class="stats-card" aria-labelledby="stats-heading">
            @* <div class="stat-item">
                <span class="stat-label">Time Worked</span>
                <span class="stat-value">@timerList.Count</span>
            </div> *@

            <div class="stat-item">
                <span class="stat-label">Projects</span>
                <span class="stat-value">@projects.Count</span>
            </div>
        </section>
    </aside>
    <div class="content">
        @if(selectedSection == "projects")
        {
            <h4 class="ps-5 pt-5">Your Projects</h4>
            <ProjectsSummaryList Projects="@projects" />
        }
        @if(selectedSection == "playlists")
        {
            <h4 class="ps-5 pt-5">Your Playlists</h4>
            <PlaylistsSummaryList Playlists="@playlists" />
        }
        @if(selectedSection == "faveTracks")
        {
            <h4 class="ps-5 pt-5">Your Tracks</h4>
            <FaveTracksSummaryList Musics="@faveTracks" />
        }
    </div>
    @* @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p aria-live="assertive" role="alert">@errorMessage</p>
    } *@
</div>


@code {
	[Parameter]
	public string UserId { get; set; }

	[Parameter, EditorRequired]
	public UserData User { get; set; } = default!;

	public HttpClient httpClient = new();

	private string selectedSection = "projects";

	private string? errorMessage;
	private List<Project> projects = new();
	private List<Playlist> playlists = new();
	private List<Music> faveTracks = new();
	private List<TaskTimer> timerList = new();

    protected override async Task OnInitializedAsync()
    {
		httpClient = HttpClientFactory.CreateClient("BackendApi");

		var token = await AccessTokenService.GetToken();
		if (!string.IsNullOrWhiteSpace(token))
		{
			httpClient.DefaultRequestHeaders.Authorization =
				new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
		}

        await ShowProjects();
    }

    private async Task ShowProjects()
    {
        try
        {
            selectedSection = "projects";

            projects = await httpClient.GetFromJsonAsync<List<Project>>($"projects");
            projects = projects?.FindAll(project => project.UserId == User.Id).ToList();

        }
        catch(Exception ex)
        {
            errorMessage = $"Could not load projects: {ex.Message}";
        }

    }
    private async Task ShowPlaylists()
    {
        try
        {
            selectedSection = "playlists";
            playlists = await httpClient.GetFromJsonAsync<List<Playlist>>("playlist") ?? new List<Playlist>();
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not load playlists: {ex.Message}";
        }
    }
    private async Task ShowFaveTracks()
    {
        try
        {
            selectedSection = "faveTracks";
            faveTracks = await httpClient.GetFromJsonAsync<List<Music>>("music");
            
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not load track lists: {ex.Message}";
        }
    }
}
