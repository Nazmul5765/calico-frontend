@using lofi_frontend.Models

@inject IHttpClientFactory HttpClientFactory;


<div class="reset-page-wrapper">
    <div class="card reset-password-card shadow">

        <h2 class="text-center mb-4">
            <span aria-hidden="true">🔑</span> Change Password
        </h2>

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success custom-alert" aria-live="polite">
                @successMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger custom-alert" aria-live="assertive" role="alert">
                @errorMessage
            </div>
        }

        <EditForm Model="userSettings" OnValidSubmit="UpdateUserSettings" FormName="UserSettingsForm">
            <DataAnnotationsValidator />

            <div class="mb-4">
                <label for="new-password" class="form-label">New Password</label>
                <InputText id="new-password"
                           type="password"
                           @bind-Value="userSettings.NewPassword"
                           class="form-control"
                           placeholder="••••••••" />

                <div class="text-danger small mt-1" aria-live="polite">
                    <ValidationMessage For="@(() => userSettings.NewPassword)" />
                </div>
            </div>

            <div class="mb-3">
                <label for="confirm-password" class="form-label">Repeat Password</label>
                <InputText id="confirm-password"
                           type="password"
                           @bind-Value="userSettings.ConfirmNewPassword"
                           class="form-control"
                           placeholder="••••••••" />

                <div class="text-danger small mt-1" aria-live="polite">
                    <ValidationMessage For="@(() => userSettings.ConfirmNewPassword)" />
                </div>
            </div>

            <p class="password-hint text-dark fw-semibold">
                💡 Please ensure your password is at least 8 characters long and includes a special character.
            </p>

            <button class="btn btn-primary w-100 reset-submit-btn" type="submit" disabled="@isUpdating">
                @(isUpdating ? "Updating..." : "Submit Changes")
            </button>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }

    private UserSettingsForm userSettings = new UserSettingsForm();
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool isUpdating = false;


    private async Task UpdateUserSettings()
    {
        isUpdating = true;  
        successMessage = string.Empty;
        errorMessage = string.Empty;
        try
        {
            var payload = new { NewPassword = userSettings.NewPassword};
            var httpClient = HttpClientFactory.CreateClient("BackendApi");

            var response = await httpClient.PostAsJsonAsync("/Auth/update-password", payload);

            if(response.IsSuccessStatusCode)
            {
                successMessage = "Password updated successfully!";
                userSettings = new UserSettingsForm();
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Failed to update password: {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            isUpdating = false;
        }
    }

}
