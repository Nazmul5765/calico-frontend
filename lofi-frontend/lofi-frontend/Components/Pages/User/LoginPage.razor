@using System.ComponentModel.DataAnnotations
@using lofi_frontend.Models
@using lofi_frontend.Security
@using lofi_frontend.Services
@page "/Login"

@rendermode InteractiveServer

@inject AuthService AuthService
@inject JWTAuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<div class="login-page">
	<div class="login-layout">
		<div class="container-fluid d-flex justify-content-center align-items-start">
			<div class="card p-4 shadow mt-5" style="width: 100%; max-width: 450px;">

				<h1 class="text-center h4 mb-4">Log in to your account</h1>

				<EditForm 
					EditContext="EditContext" 
					OnValidSubmit="HandleSignIn" 
					FormName="Login Form">
					<DataAnnotationsValidator />

					<div class="mb-3">
						<label for="email_input" class="form-label" aria-required="true">Email address</label>
						<InputText id="email_input" @bind-Value="LoginForm.Email"
						           class="form-control" />
						<div class="text-danger small"><ValidationMessage For="@(() => LoginForm.Email)" /></div>
					</div>

					<div class="mb-3">
						<label for="password_input" class="form-label" aria-required="true">Password</label>
						<InputText id="password_input" @bind-Value="LoginForm.Password" 
						           class="form-control" type="password" />
						<div class="text-danger small"><ValidationMessage For="@(() => LoginForm.Password)" /></div>
					</div>

					<NavLink href="forgot-password" class="btn btn-outline-secondary w-100">
						Forgot Password?
					</NavLink>
					@if (!string.IsNullOrEmpty(_errorMessage))
					{
						<div class="alert alert-danger p-2 small text-center mb-3" role="alert" aria-live="assertive">
							@_errorMessage
						</div>
					}

					<div class="d-grid gap-2 mb-3">
						<button class="btn btn-primary" type="submit">Login</button>

						@* <button class="btn btn-outline-dark" type="button">
                    <img src="https://developers.google.com/identity/images/g-logo.png" alt="Google logo" style="width:16px; margin-right:8px; vertical-align:middle;" />
                    Login with Google
                    </button> *@
					</div>

					<hr />

					<div class="text-center">
						<p class="mb-2 text-muted small">Don't have an account?</p>
						<NavLink href="Signup" class="btn btn-outline-secondary w-100">
							Create an account
						</NavLink>
					</div>
				</EditForm>
			</div>
		</div>
	</div>
</div>

@code {
	private LoginFormData LoginForm { get; } = new();
	public EditContext? EditContext { get; set; }

	private string? _errorMessage;

	protected override void OnInitialized()
	{
		EditContext = new EditContext(LoginForm);
	}

	private async Task HandleSignIn()
	{
		Console.WriteLine("Attempting to sign into email: " + LoginForm.Email);
		_errorMessage = null;

		try
		{
			var response = await AuthService.Login(LoginForm.Email, LoginForm.Password);
			Console.WriteLine("Login response: " + response);

			if (response)
			{
				AuthStateProvider.NotifyUserLogin();
				Console.WriteLine("User logged in, navigating to homeage");
				NavigationManager.NavigateTo("/");
			}
			else
			{
				_errorMessage = "Incorrect email or password";
			}
		}
		catch (Exception ex)
		{
			_errorMessage = "An error occurred while trying to authenticate. Please try again later.";
			Console.WriteLine($"Error during authentication: {ex.Message} | \n {ex.StackTrace}");
		}
	}

	public class LoginFormData
	{
		[Required] [EmailAddress]
		public string Email { get; set; } = string.Empty;
		[Required]
		public string Password { get; set; } = string.Empty;
	}
}
