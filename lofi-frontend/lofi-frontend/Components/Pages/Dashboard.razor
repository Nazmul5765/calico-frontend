@using lofi_frontend.Components.Pages.User.Components
@using lofi_frontend.Models
@using lofi_frontend.Services
@page "/Dashboard"

@inject AuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>User Dashboard</PageTitle>
<div class="page-container dashboard-page">
@if (User != null)
{
    <DashboardElements User="@User" UserId="@User.Id" />
}
else if (LoadFailed)
{
    <p>Something went wrong loading your profile. <a href="/Dashboard">Try again</a>.</p>
}
else
{
    <p>Loading...</p>
}
</div>

@code {
    private UserData? User { get; set; }
    private bool LoadFailed { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            User = await AuthService.GetCurrentUser();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching current user: {ex.Message}");
            LoadFailed = true;
            StateHasChanged();
            return;
        }

        if (User == null)
        {
            NavigationManager.NavigateTo("/Login");
        }
        else
        {
            StateHasChanged();
        }
    }
}
